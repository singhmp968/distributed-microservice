<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Pull the app name from Spring's environment (application.yaml) -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>

    <!-- Reusable values -->
    <property name="LOG_DIR" value="logs"/>
    <!-- Layout/format = the "Formatter" in your LLD. Includes the tracing MDC
         (traceId/spanId) that Micrometer puts there — ties into your Grafana/Tempo work. -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME},%X{traceId:-},%X{spanId:-}] [%thread] %logger{36} - %msg%n"/>

    <!-- ============================================================
         APPENDERS = WHERE the log goes (concrete Appender implementations)
         ============================================================ -->

    <!-- 1) Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 2) Rolling file appender (rotates by size + date, keeps history) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>      <!-- roll when a file hits 10MB -->
            <maxHistory>7</maxHistory>           <!-- keep 7 days of logs -->
            <totalSizeCap>200MB</totalSizeCap>   <!-- cap total disk usage -->
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Async wrapper around FILE — writes on a background thread -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
    </appender>




    <appender name="CONSOLE_WITH_MDC" class="ch.qos.logback.core.ConsoleAppender">
        <!-- the MDC key to sift by -->
        <encoder>
            <pattern>%d %level %logger - %msg - %X{payment_id}%n</pattern>
        </encoder>
    </appender>

    <!-- ============================================================
         LOGGERS + LEVELS = the filter (only >= level is emitted)
         ============================================================ -->

<!--    <logger name="com.cc.orderService" level="INFO" additivity="true">-->
<!--        <appender-ref ref="CONSOLE" />-->
<!--    </logger>-->


    <!-- App package logs at DEBUG; everything else follows <root> -->
<!--    <logger name="com.cc.orderService" level="DEBUG"/>-->

    <!-- Profile-specific wiring: which appenders are active per environment -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="CONSOLE_WITH_MDC"/>

        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="ASYNC_FILE"/>   <!-- no console noise in prod -->
        </root>
    </springProfile>

    <!-- Default when neither dev nor prod is active -->
    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
